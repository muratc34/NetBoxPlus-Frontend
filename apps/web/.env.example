# Settings of the web server, read only on the server (no NEXT_PUBLIC_ prefix, so never in a browser bundle).
# Locally copy this file to .env.local; Next.js loads it.

# The gateway as this server reaches it while rendering pages (in containers: http://gateway:8080).
GATEWAY_INTERNAL_URL=http://localhost:5100

# GATEWAY_SERVER_KEY from the backend's deploy/.env. With it the gateway counts rendering requests
# against the visitor; without it, against this server's own address.
GATEWAY_SERVER_KEY=

# Proxies in front of this server that append to X-Forwarded-For. With 0 (none) the header can only
# come from the browser, so no visitor is named.
TRUSTED_PROXY_HOPS=0

# Locally copy this file to .env.local; Next.js loads it.

# The gateway as the browser reaches it; NEXT_PUBLIC_ values are built into the browser bundle.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:5100

# The rest is read only on the server (no NEXT_PUBLIC_ prefix, so never in a browser bundle).

# The gateway as this server reaches it while rendering pages (in containers: http://gateway:8080).
GATEWAY_INTERNAL_URL=http://localhost:5100

# GATEWAY_SERVER_KEY from the backend's deploy/.env. With it the gateway counts rendering requests
# against the visitor; without it, against this server's own address.
GATEWAY_SERVER_KEY=

# Proxies in front of this server that append to X-Forwarded-For. With 0 (none) the header can only
# come from the browser, so no visitor is named.
TRUSTED_PROXY_HOPS=0

# Where Catalog's images and Streaming's video are served from, space-separated; allowed by the
# Content-Security-Policy. Locally Azurite.
STORAGE_ORIGINS=http://127.0.0.1:10000

# The site's public address, for canonical links and the sitemap.
SITE_URL=http://localhost:5173
